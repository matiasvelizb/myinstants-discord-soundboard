# ── Required ────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# ── Bot ─────────────────────────────────────────────────────
# Register commands to one server instantly, instead of globally (up to 1 hour)
GUILD_ID=
# Oldest sounds are removed past this limit. 0 = unlimited
MAX_SOUNDS_PER_GUILD=1000

# ── Text to speech ──────────────────────────────────────────
# Voice /read uses until a user picks one with /voice (ids in src/tts/voices.js)
TTS_DEFAULT_VOICE=catalina
# Longest text /read accepts, in characters
TTS_MAX_LENGTH=1000

# ── Storage ─────────────────────────────────────────────────
# SQLite database and audio files (Docker Compose uses ./data)
DATA_DIR=data

# ── Logging ─────────────────────────────────────────────────
# Daily activity logs, kept 7 days (Docker Compose uses ./logs)
LOG_DIR=logs
# info or debug
LOG_LEVEL=info
# Timezone for log timestamps
TZ=America/Santiago

# ── Cloudflare fallback ─────────────────────────────────────
# FlareSolverr solves JavaScript challenges when MyInstants escalates.
# Docker Compose sets the URL automatically.
FLARESOLVERR_URL=
FLARESOLVERR_ENABLED=true
FLARESOLVERR_MAX_TIMEOUT=60000
